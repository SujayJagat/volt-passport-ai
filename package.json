{
  "name": "volt-passport-ai",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "concurrently \"npm run pb\" \"npm run dev\"",
    "dev:all": "concurrently \"npm run pb\" \"npm run dev\"",
    "dev": "vite --host",
    "pb": "node scripts/init-pocketbase.mjs --serve",
    "seed": "node scripts/init-pocketbase.mjs",
    "build": "vite build",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^0.453.0",
    "pocketbase": "^0.28.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.3",
    "typescript": "5.9.3",
    "vite": "^7.1.7",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.15.1"
}
